# Read from the repository root in every mode (npm run dev, npm start, tests).
# Precedence: real environment variables > .env.local (optional, git-ignored) > .env.
# In development, saving this file restarts the API server, and the web proxy follows PORT / HOST.

# ---- Server ----
PORT=8787
HOST=127.0.0.1
# Where journal, watchlists, alerts and settings are persisted (JSON files, atomic writes)
DATA_DIR=./data

# ---- Access control ----
# The API has no login, so browsers may only call it from this machine: pages served from
# localhost / 127.0.0.1 (any port) or by this server itself. To allow another device, a custom
# hostname or a reverse proxy, list the exact origins here, comma-separated, for example
# ALLOWED_ORIGINS=http://192.168.1.20:5173,https://terminal.example.com
ALLOWED_ORIGINS=

# ---- AI (optional) ----
# Without a key, every "AI" explanation is produced by the deterministic rule-based
# explainer and is labelled as such in the UI. With a key, Claude writes the narrative
# from verified, pre-computed facts only (numbers are grounded and checked).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Gold spot (optional) ----
# Spot XAU/USD works without any key: history from the Dukascopy archive, live quotes from
# Swissquote's public feed, independent cross-check against gold-api.com. A Twelve Data key
# (free tier: 8 req/min, 800/day) makes Twelve Data the primary source and adds it to the
# verification panel. Tokenised gold (PAXG) is never used as a substitute for spot.
# Free key: create an account at https://twelvedata.com/register, confirm the email, then copy the
# key from https://twelvedata.com/account/api-keys
TWELVEDATA_API_KEY=

# ---- Macro (optional) ----
# FRED (St. Louis Fed) for DGS10/DGS2/DFII10 yields. Without a key, Treasury yields come
# from home.treasury.gov (keyless, daily). The US Dollar Index never needs a key: it is
# computed with the ICE formula from the six constituent FX rates (Swissquote live,
# Dukascopy history) and labelled as computed rather than the licensed ICE print.
# Free key: sign in at https://fredaccount.stlouisfed.org/apikeys and choose "Request API Key".
FRED_API_KEY=

# ---- Economic calendar ----
# The built-in schedule file (data/official-schedule.json) carries dates published by the
# Federal Reserve, BLS and BEA. The Forex Factory weekly feed adds forecasts/previous
# values for the current and next week. Set to "false" to disable that feed.
CALENDAR_FF_FEED=true

# ---- Demo mode ----
# "auto": use live providers, fall back to explicit DEMO data only when all providers fail.
# "force": always use demo data (for UI development without network).
# "off": never use demo data; show error states instead.
DEMO_MODE=auto
